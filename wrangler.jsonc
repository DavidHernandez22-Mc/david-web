// Configuración del Worker que publica el sitio estático (Cloudflare Workers, static assets).
// Workers Builds corre `npm run build` y luego `npx wrangler deploy`, que lee este archivo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "david-web",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Una URL inexistente responde 404 con el 404.html más cercano: /en/... usa en/404.html.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
