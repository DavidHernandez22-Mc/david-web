// Configuración del Worker que publica el sitio (Cloudflare Workers con static assets).
// Workers Builds corre `npm run build` y luego `npx wrangler deploy`, que lee este archivo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "david-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Dominio propio (la zona está en la misma cuenta). www solo existe para redirigir.
  "routes": [
    { "pattern": "davidhcwebs.com", "custom_domain": true },
    { "pattern": "www.davidhcwebs.com", "custom_domain": true }
  ],
  // La dirección de workers.dev sigue activa para que los enlaces viejos redirijan con 301.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Todo pasa primero por el Worker: redirige www y workers.dev al dominio principal
    // y atiende /api/event. El resto lo entrega desde dist/ con env.ASSETS.
    "run_worker_first": true,
    // Una URL inexistente responde 404 con el 404.html más cercano: /en/... usa en/404.html.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Clics y visitas. El dataset se crea solo con el primer evento.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "david_web_events" }],
  "observability": { "enabled": true }
}
