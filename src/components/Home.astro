---
import Base from '../layouts/Base.astro';
import Icons from './Icons.astro';
import logo from './logo-paths.json';
import wordmark from './wordmark.json';
import { es } from '../i18n/es';
import { en } from '../i18n/en';
import { COP_PRICES, DEMOS, SECTOR_THEME, USD_PRICES, demoSrcset, demoUrl, wa, type DemoId, type PackageId, type SectorId } from '../i18n/shared';
import { BRAND_NAME, EVENTS_ENDPOINT_ENABLED, OFFER, SITE_URL, WHATSAPP_NUMBER } from '../../site.config.mjs';
import { existsSync } from 'node:fs';

interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const t = lang === 'es' ? es : en;
const isEs = lang === 'es';

const general = t.sectors.general;
const baseMessage = `${t.wa.base} ${t.wa.fallbackNoun}.`;
const waGeneral = wa(WHATSAPP_NUMBER, baseMessage);
const sectorIds = ['odontologia', 'estetica', 'veterinaria', 'inmobiliaria', 'restaurante', 'otro'] as const;
const packageIds: PackageId[] = ['esencial', 'profesional', 'premium'];
const prices = isEs ? COP_PRICES : USD_PRICES;
const fmt = new Intl.NumberFormat(t.calc.numberFormat, { maximumFractionDigits: 0 });
const money = (n: number) => `$${fmt.format(n)}`;
const cheapest = Math.min(...Object.values(prices));

// La oferta sale de una sola línea de site.config.mjs (OFFER).
const offerOn = OFFER.active && OFFER.spotsLeft > 0;
const pct = `${Math.round(OFFER.discount * 100)}%`;
const offerPrice = (p: PackageId) => (isEs ? Math.round((COP_PRICES[p] * (1 - OFFER.discount)) / 10000) * 10000 : Math.round(USD_PRICES[p] * (1 - OFFER.discount)));

// La escena del hero: la demo por defecto y las que rota cuando no hay sector elegido.
const sceneDemos: DemoId[] = ['odontologia', 'restaurante', 'veterinaria', 'inmobiliaria', 'estetica'];
const sectorToDemo: Partial<Record<SectorId, DemoId>> = { odontologia: 'odontologia', estetica: 'estetica', veterinaria: 'veterinaria', inmobiliaria: 'inmobiliaria', restaurante: 'restaurante' };
const demoName = (id: string) => DEMOS.find((d) => d.id === id)?.name ?? '';
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const titleWords = t.hero.titleLead.split(' ');

const pageData = {
  lang,
  number: WHATSAPP_NUMBER,
  events: EVENTS_ENDPOINT_ENABLED,
  themes: SECTOR_THEME,
  sectorToDemo,
  sectors: Object.fromEntries(Object.entries(t.sectors).map(([k, v]) => [k, { sub: v.sub, noun: v.noun, chip: v.chip }])),
  wa: { base: t.wa.base, fallbackNoun: t.wa.fallbackNoun, demoSuffix: t.wa.demoSuffix('{d}'), calcSuffix: t.wa.calcSuffix, formName: t.wa.formName, formBusiness: t.wa.formBusiness, formNeed: t.wa.formNeed },
  prices,
  calc: { months: t.calc.months('{n}'), oneMonth: t.calc.oneMonth, lessThanOne: t.calc.lessThanOne, empty: t.calc.empty, locale: t.calc.numberFormat },
  errors: t.close.errors,
  demos: Object.fromEntries(DEMOS.map((d) => [d.id, { name: d.name, url: demoUrl(d, lang), live: d.live, iframe: d.iframe, bg: d.bg, ink: d.ink }])),
};

const home = new URL(t.home, SITE_URL).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#service`,
      name: BRAND_NAME,
      url: home,
      image: new URL(isEs ? '/og-es.png' : '/og-en.png', SITE_URL).href,
      logo: new URL('/icon-512.png', SITE_URL).href,
      description: t.jsonLd.description,
      telephone: `+${WHATSAPP_NUMBER}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressRegion: 'Bogotá D.C.', addressCountry: 'CO' },
      areaServed: [
        { '@type': 'City', name: 'Bogotá' },
        { '@type': 'Country', name: 'Colombia' },
      ],
      openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '00:00', closes: '23:59' }],
      inLanguage: lang,
      priceRange: isEs ? `${money(COP_PRICES.esencial)} - ${money(COP_PRICES.premium)} COP` : `${money(USD_PRICES.esencial)} - ${money(USD_PRICES.premium)} USD`,
      founder: { '@id': `${SITE_URL}/#david` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#david`,
      name: 'David Hernández Castro',
      jobTitle: t.jsonLd.jobTitle,
      worksFor: { '@id': `${SITE_URL}/#service` },
      url: home,
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
    },
  ],
};
const pkg = t.pricing.packages;
// Tu foto: guarda public/assets/foto-david.webp (576×720, 4:5) y aparece sola en el próximo build. Sin archivo, se ve el monograma.
const hasPhoto = existsSync('public/assets/foto-david.webp');
const Logo = { w: logo.w, box: logo.box };
---
<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  ogImage={isEs ? '/og-es.png' : '/og-en.png'}
  ogAlt={t.meta.ogAlt}
  path={t.home}
  altPath={t.otherHome}
  jsonLd={jsonLd}
  preloadImage={{ srcset: demoSrcset('odontologia', 'desktop'), sizes: '(min-width: 1024px) 44vw, 1px', media: '(min-width: 1024px)', priority: 'high' }}
>
  <Icons />
  <a class="skip" href="#main">{t.skip}</a>

  <header class="bar">
    <a class="logo" href={t.home} aria-label={t.logoLabel}>
      <svg viewBox={`0 0 ${Logo.w} ${Logo.box}`} aria-hidden="true"><rect width={Logo.box} height={Logo.box} fill="currentColor" /><path class="logo-cut" d={logo.dh} /><path fill="currentColor" d={logo.name} /><path fill="currentColor" d={logo.webs} /></svg>
    </a>
    <nav class="bar-nav" aria-label={t.nav.label}>
      <a class="nav-sec" href="#demos">{t.nav.demos}</a>
      <a class="nav-sec" href="#paquetes">{t.nav.packages}</a>
      <a class="nav-sec" href="#preguntas">{t.nav.faq}</a>
      <a class="nav-lang" href={t.otherHome} hreflang={isEs ? 'en' : 'es'} lang={isEs ? 'en' : 'es'} aria-label={t.otherFull}>{t.otherLabel}</a>
      <a class="btn btn-bar nav-sec" href={waGeneral} target="_blank" rel="noopener" data-wa="bar" data-track="whatsapp_click" data-label="barra"><svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.nav.cta}</a>
      <button class="menu-btn" type="button" aria-label={t.nav.menuLabel} aria-haspopup="dialog" data-menu-open>{t.nav.menu}</button>
    </nav>
  </header>

  <dialog class="menu" data-menu aria-label={t.nav.menu} data-lenis-prevent>
    <div class="menu-top">
      <svg class="menu-logo" viewBox={`0 0 ${Logo.w} ${Logo.box}`} aria-hidden="true"><rect width={Logo.box} height={Logo.box} fill="currentColor" /><path class="menu-logo-cut" d={logo.dh} /><path fill="currentColor" d={logo.name} /><path fill="currentColor" d={logo.webs} /></svg>
      <button class="menu-close" type="button" aria-label={t.nav.close} data-menu-close autofocus><svg aria-hidden="true"><use href="#i-close" /></svg></button>
    </div>
    <nav aria-label={t.nav.menu}>
      <ul class="menu-links">
        <li><a href="#demos" data-menu-link>{t.nav.demos}</a></li>
        <li><a href="#paquetes" data-menu-link>{t.nav.packages}</a></li>
        <li><a href="#preguntas" data-menu-link>{t.nav.faq}</a></li>
        <li><a href="#escribeme" data-menu-link>{t.nav.cta}</a></li>
      </ul>
    </nav>
  </dialog>

  <main id="main">
    <section class="hero" id="hero" aria-labelledby="hero-title">
      <div class="wrap hero-in">
        <div class="hero-copy">
          <h1 id="hero-title" class="hero-title">
            {titleWords.map((w, i) => <><span class="hw" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}
            <span class="hw hw-frame" style={`--i:${titleWords.length}`} aria-hidden="true"><span class="h-frame">
              {sceneDemos.map((id, i) => (
                <img class:list={['shot', { 'is-on': i === 0 }]} data-group="frame" data-demo={id} src={i === 0 ? `/demos/${id}-mobile-260.webp` : blank} data-src={i === 0 ? undefined : `/demos/${id}-mobile-260.webp`} width="260" height="563" alt="" decoding="async" />
              ))}
            </span></span>{' '}
            <span class="hw" style={`--i:${titleWords.length + 1}`}><span class="h-word" data-h-word>{general.noun}.</span></span>
          </h1>
          <div class="hero-foot">
            <p class="hero-sub" data-h-sub aria-live="polite">{general.sub}</p>
            <div class="hero-actions">
              <a class="btn btn-hero" href={waGeneral} target="_blank" rel="noopener" data-wa="hero" data-track="whatsapp_click" data-label="hero" data-magnetic>
                <svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.hero.primary}
              </a>
              <a class="text-link link-arrow" href="#demos" data-hero-demos data-default={t.hero.secondary} data-this={t.hero.seeThis}><span>{t.hero.secondary}</span><svg class="ico" aria-hidden="true"><use href="#i-arrow" /></svg></a>
            </div>
          </div>
        </div>

        <div class="hero-scene">
          <a class="scene-link" href="#demos" data-hero-phone aria-label={t.hero.openScene}>
            <span class="device laptop" data-depth="1">
              <span class="laptop-screen">
                {sceneDemos.map((id, i) => (
                  <img
                    class:list={['shot', { 'is-on': i === 0 }]}
                    data-group="laptop"
                    data-demo={id}
                    srcset={i === 0 ? demoSrcset(id, 'desktop') : undefined}
                    data-srcset={i === 0 ? undefined : demoSrcset(id, 'desktop')}
                    src={i === 0 ? `/demos/${id}-desktop-960.webp` : blank}
                    sizes="(min-width: 1024px) 44vw, 90vw"
                    width="1440"
                    height="900"
                    alt={i === 0 ? t.hero.desktopAlt(demoName(id)) : ''}
                    data-alt={t.hero.desktopAlt(demoName(id))}
                    decoding="async"
                    fetchpriority={i === 0 ? 'high' : undefined}
                  />
                ))}
              </span>
            </span>
            <span class="device phone hero-phone" data-depth="2">
              <span class="phone-screen">
                {sceneDemos.map((id, i) => (
                  <img
                    class:list={['shot', { 'is-on': i === 0 }]}
                    data-group="phone"
                    data-demo={id}
                    srcset={i === 0 ? demoSrcset(id, 'mobile') : undefined}
                    data-srcset={i === 0 ? undefined : demoSrcset(id, 'mobile')}
                    src={i === 0 ? `/demos/${id}-mobile-390.webp` : blank}
                    sizes="(min-width: 1024px) 220px, 42vw"
                    width="390"
                    height="844"
                    alt={i === 0 ? t.hero.phoneAlt(demoName(id)) : ''}
                    data-alt={t.hero.phoneAlt(demoName(id))}
                    decoding="async"
                  />
                ))}
              </span>
            </span>
          </a>
          <p class="frag frag-bubble" data-depth="3" aria-hidden="true"><span data-bubble>{baseMessage}</span></p>
          <p class="frag frag-price" data-depth="3"><span>{t.hero.priceTag(money(cheapest))}</span></p>
          <p class="frag frag-stamp" data-depth="3"><span>{t.hero.stamp}</span></p>
        </div>
      </div>

      <div class="wrap picker-band">
        <fieldset class="picker">
          <legend>{t.hero.question}</legend>
          <p class="picker-sub">{t.hero.pickerSub}</p>
          <div class="chips">
            {sectorIds.map((id) => (
              <label class="chip"><input type="radio" name="sector" value={id} /><span>{t.sectors[id].chip}</span></label>
            ))}
          </div>
        </fieldset>
      </div>
    </section>

    <section class="problem" aria-labelledby="problem-title">
      <div class="wrap problem-in">
        <h2 id="problem-title" class="h2" data-split>{t.problem.title}</h2>
        <div class="problem-grid">
          <article class="pb pb-chat" data-reveal>
            <div class="pb-text"><h3>{t.problem.chat.title}</h3><p>{t.problem.chat.text}</p></div>
            <div class="pb-chatlog" aria-hidden="true">
              {t.problem.chat.bubbles.map((b, i) => <span class:list={['bubble', 'bubble-in', { 'only-wide-b': i > 2 }]} style={`--i:${i}`}>{b}</span>)}
            </div>
          </article>
          <article class="pb pb-insta" data-reveal>
            <div class="pb-art" aria-hidden="true">
              <div class="mini-search"><span>{t.problem.insta.search}</span><em>{t.problem.insta.none}</em></div>
              <span class="mini-post">{t.problem.insta.post}</span>
            </div>
            <div class="pb-text"><h3>{t.problem.insta.title}</h3><p>{t.problem.insta.text}</p></div>
          </article>
          <article class="pb pb-old" data-reveal>
            <div class="pb-art" aria-hidden="true">
              <div class="mini-old"><span class="mini-url">{t.problem.old.url}</span><strong>{t.problem.old.notice}</strong></div>
            </div>
            <div class="pb-text"><h3>{t.problem.old.title}</h3><p>{t.problem.old.text}</p></div>
          </article>
        </div>
      </div>
    </section>

    <section id="demos" class="demos" aria-labelledby="demos-title">
      <div class="wrap demos-head">
        <h2 id="demos-title" class="h2" data-split>{t.demos.title}</h2>
        <div class="demos-intro">
          <p class="lead" data-reveal>{t.demos.intro}</p>
          <a class="text-link skip-demos" href="#despues-demos"><span>{t.demos.skip}</span><svg class="ico ico-down" aria-hidden="true"><use href="#i-arrow" /></svg></a>
        </div>
      </div>
      <div class="demo-stage" data-demo-stage style={`--n:${DEMOS.length}`}>
        <div class="demo-sticky">
          <div class="wrap demo-meta" aria-hidden="true">
            <p class="demo-count" data-demo-count>{t.demos.progress(1, DEMOS.length)}</p>
            <ol class="demo-index">
              {DEMOS.map((d, i) => <li class:list={{ 'is-on': i === 0 }} data-demo-name={i}>{t.demos.items[d.id].sector}</li>)}
            </ol>
          </div>
          <p class="sr-only">{t.demos.swipe}</p>
          <ul class="demo-list" data-demo-list aria-label={t.demos.title}>
            {DEMOS.map((d, i) => {
              const item = t.demos.items[d.id];
              return (
                <li class:list={['demo-panel', { 'is-active': i === 0 }]} data-demo-panel={i} style={`--p-bg:${d.bg};--p-ink:${d.ink};--p-btn:${d.btn};--p-btn-ink:${d.btnInk}`}>
                  <a
                    class="demo-card"
                    href={d.live ? demoUrl(d, lang) : wa(WHATSAPP_NUMBER, `${baseMessage} ${t.wa.lumenSuffix}`)}
                    target="_blank"
                    rel="noopener"
                    data-demo-open={d.live ? d.id : undefined}
                    data-track={d.live ? 'demo_open' : 'whatsapp_click'}
                    data-label={d.live ? d.id : `demo-offline-${d.id}`}
                    data-tilt
                  >
                    <span class="demo-text">
                      <span class="demo-h">{item.sector}{item.tag && <span class="demo-tag"> · {item.tag}</span>}</span>
                      <span class="demo-hook">{item.hook}</span>
                      <span class="demo-name">{d.name}</span>
                      <span class="btn demo-btn">{d.live ? t.demos.open : t.demos.unavailable}<svg class="ico" aria-hidden="true"><use href="#i-arrow" /></svg></span>
                    </span>
                    <span class="demo-visual">
                      <img class="demo-desktop" srcset={demoSrcset(d.id, 'desktop')} src={`/demos/${d.id}-desktop-960.webp`} sizes="(min-width: 1024px) 46vw, 1px" width="1440" height="900" alt={t.demos.desktopAlt(d.name)} loading="lazy" decoding="async" />
                      <span class="phone demo-phone">
                        <span class="phone-screen">
                          <img srcset={demoSrcset(d.id, 'mobile')} src={`/demos/${d.id}-mobile-390.webp`} sizes="(min-width: 1024px) 230px, 52vw" width="390" height="844" alt={t.demos.phoneAlt(d.name)} loading="lazy" decoding="async" />
                        </span>
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
          <div class="demo-dots" data-demo-dots role="group" aria-label={t.demos.dotsLabel}>
            {DEMOS.map((_, i) => <button type="button" class:list={['dot', { 'is-on': i === 0 }]} data-demo-dot={i} aria-label={t.demos.progressLabel(i + 1, DEMOS.length)} aria-current={i === 0 ? 'true' : undefined}><i /></button>)}
          </div>
        </div>
        <div class="demo-steps" aria-hidden="true">{DEMOS.map((_, i) => <i data-demo-step={i} />)}</div>
      </div>
      <p class="wrap fine" id="despues-demos" tabindex="-1">{t.demos.fine}</p>
    </section>

    <section class="steps" aria-labelledby="steps-title">
      <div class="wrap">
        <h2 id="steps-title" class="h2" data-split>{t.steps.title}</h2>
        <div class="timeline">
          <span class="tl-line" aria-hidden="true"><i data-tl-line /></span>
          <ol class="steps-list">
            {t.steps.items.map((s) => (
              <li data-reveal>
                <span class="step-time">{s.time}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="receive" aria-labelledby="receive-title">
      <div class="wrap">
        <div class="receive-head">
          <h2 id="receive-title" class="h2" data-split>{t.receive.title}</h2>
          <p class="lead" data-reveal>{t.receive.intro}</p>
        </div>
        <ul class="bento">
          {t.receive.items.map((it) => (
            <li class:list={['bt', `bt-${it.k}`]} data-reveal data-tilt>
              <div class="bt-art" aria-hidden="true">
                {it.k === 'design' && <span class="swatches">{DEMOS.map((d) => <i style={`background:${d.bg === '#dedad3' ? d.btn : d.bg}`} />)}</span>}
                {it.k === 'copy' && <span class="bt-quote">{it.quote}</span>}
                {it.k === 'phone' && <span class="mini-phone"><i /><i /><i /><b><svg><use href="#i-wa" /></svg></b></span>}
                {it.k === 'own' && <span class="bt-own"><span class="bt-url">{it.url}</span><span class="bt-big">20 min</span></span>}
              </div>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="pricing" id="paquetes" aria-labelledby="pricing-title">
      <div class="wrap">
        <h2 id="pricing-title" class="h2" data-split>{t.pricing.title}</h2>
        <p class="lead" data-reveal>{t.pricing.intro}</p>
        <div class="tabs" role="group" aria-label={t.pricing.tabsLabel} data-tabs>
          {packageIds.map((p) => <button type="button" class:list={['tab', { 'is-on': p === 'profesional' }]} aria-pressed={p === 'profesional' ? 'true' : 'false'} data-tab={p}>{pkg[p].name}</button>)}
        </div>
      </div>
      <ul class="tickets" data-tickets tabindex="0" aria-label={t.pricing.tabsLabel}>
        {packageIds.map((p) => (
          <li class:list={['ticket', { 'ticket-hot': p === 'profesional' }]} data-ticket={p} data-reveal>
            <div class="ticket-in" data-tilt>
              <div class="ticket-main">
                {p === 'profesional' && <p class="ticket-badge">{t.pricing.badge}</p>}
                <h3>{pkg[p].name}</h3>
                <p class="ticket-line">{pkg[p].tagline}</p>
                <p class="ticket-price"><small>{t.pricing.from}</small> <span>{money(prices[p])}</span>{!isEs && <small> USD</small>}</p>
                {offerOn && <p class="ticket-offer">{t.pricing.offerLine(pct, money(offerPrice(p)))}</p>}
                <ul class="ticket-items">
                  {pkg[p].items.map((i) => <li><svg class="ico-check" aria-hidden="true"><use href="#i-check" /></svg><span>{i}</span></li>)}
                </ul>
              </div>
              <a class="btn ticket-btn" href={wa(WHATSAPP_NUMBER, `${baseMessage} ${t.wa.packageSuffix(pkg[p].name)}`)} target="_blank" rel="noopener" data-wa="package" data-wa-suffix={t.wa.packageSuffix(pkg[p].name)} data-track="package_click" data-label={p}>
                <svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.pricing.ctaPrefix} {pkg[p].name}
              </a>
            </div>
          </li>
        ))}
      </ul>
      <div class="wrap">
        <div class="maint" data-reveal>
          <div class="maint-text"><h3>{t.pricing.maintenance.name}</h3><p>{t.pricing.maintenance.text}</p></div>
          <p class="maint-price">{t.pricing.maintenance.price}<small>{t.pricing.maintenance.unit}</small></p>
          <a class="btn btn-accent" href={wa(WHATSAPP_NUMBER, `${baseMessage} ${t.wa.packageSuffix(t.wa.maintenance)}`)} target="_blank" rel="noopener" data-wa="package" data-wa-suffix={t.wa.packageSuffix(t.wa.maintenance)} data-track="package_click" data-label="mantenimiento"><svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.pricing.maintenance.cta}</a>
        </div>
        <ul class="terms">
          {t.pricing.conditions.map((c) => <li data-reveal><strong>{c.big}</strong><span>{c.text}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="calc" id="calculadora" aria-labelledby="calc-title">
      <div class="wrap calc-grid">
        <div class="calc-head">
          <h2 id="calc-title" class="h2" data-split>{t.calc.title}</h2>
          <p class="lead" data-reveal>{t.calc.intro}</p>
        </div>
        <form class="calc-form" data-calc data-reveal>
          <p class="calc-example" data-calc-example>{t.calc.example}</p>
          <div class="field">
            <label for="c-clients">{t.calc.clients}</label>
            <input id="c-clients" name="clients" type="text" inputmode="numeric" autocomplete="off" value="20" />
          </div>
          <div class="field">
            <label for="c-value">{t.calc.value}{!isEs && ' (USD)'}</label>
            <div class="field-money"><span aria-hidden="true">{t.calc.valuePrefix}</span><input id="c-value" name="value" type="text" inputmode="numeric" autocomplete="off" value={isEs ? '150.000' : '50'} /></div>
          </div>
          <fieldset class="seg">
            <legend>{t.calc.extra}</legend>
            <div class="seg-row">
              {[1, 3, 5].map((n) => <label><input type="radio" name="extra" value={n} checked={n === 3} /><span>{n}</span></label>)}
            </div>
            <p class="seg-hint">{t.calc.extraHint}</p>
          </fieldset>
        </form>
        <div class="calc-out" data-reveal aria-live="polite">
          <p class="calc-flow"><span>{t.calc.today} <strong data-calc-today>—</strong> {t.calc.perMonth}.</span> <span>{t.calc.withWeb} <strong data-calc-with>—</strong>.</span></p>
          <h3>{t.calc.resultsTitle}</h3>
          <ul class="calc-results">
            {packageIds.map((p) => (
              <li data-calc-row={p} class:list={{ 'is-hot': p === 'profesional' }}>
                <span class="calc-name">{pkg[p].name}{p === 'profesional' && <em> · {t.pricing.badge}</em>}<small>{t.pricing.from} {money(prices[p])}</small></span>
                <strong data-calc-months>—</strong>
                <span class="calc-bar" aria-hidden="true"><i /></span>
              </li>
            ))}
          </ul>
          <p class="calc-honest">{t.calc.honest}</p>
          <noscript><p class="calc-honest">{t.calc.noscript}</p></noscript>
          <a class="btn btn-accent" href={waGeneral} target="_blank" rel="noopener" data-wa="calc" data-calc-cta data-track="whatsapp_click" data-label="calculadora"><svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.calc.cta}</a>
        </div>
      </div>
    </section>

    {offerOn && (
      <section class="offer" aria-labelledby="offer-title">
        <div class="wrap offer-in">
          <p class="offer-big" aria-hidden="true" data-offer-big>{pct}</p>
          <div class="offer-side">
            <h2 id="offer-title" class="offer-title" data-reveal>{t.offer.title(pct, OFFER.spotsTotal)}</h2>
            <p data-reveal>{t.offer.text}</p>
            <p class="offer-stamp" data-offer-stamp>{t.offer.stamp(OFFER.spotsLeft, OFFER.spotsTotal)}</p>
            <a class="btn" href={wa(WHATSAPP_NUMBER, `${baseMessage} ${t.wa.offer(pct)}`)} target="_blank" rel="noopener" data-wa="offer" data-wa-suffix={t.wa.offer(pct)} data-track="whatsapp_click" data-label="oferta" data-magnetic><svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.offer.cta(OFFER.spotsTotal)}</a>
          </div>
        </div>
      </section>
    )}

    <section class="about" id="sobre-mi" aria-labelledby="about-title">
      <div class="wrap about-grid">
        <div class="about-media" data-about-media>
          {hasPhoto
            ? <img class="about-photo" src="/assets/foto-david.webp" width="576" height="720" alt={t.about.photoAlt} loading="lazy" decoding="async" />
            : <span class="monogram" role="img" aria-label={t.about.monogramAlt}><span aria-hidden="true">dh</span></span>}
        </div>
        <div class="about-text">
          <h2 id="about-title" class="h2" data-split>{t.about.title}</h2>
          {t.about.paragraphs.map((p) => <p class="about-p" data-reveal>{p}</p>)}
          <h3 data-reveal>{t.about.workTitle}</h3>
          <ul class="about-work" data-reveal>{t.about.work.map((w) => <li>{w}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="faq" id="preguntas" aria-labelledby="faq-title">
      <div class="wrap faq-grid">
        <div class="faq-head">
          <h2 id="faq-title" class="h2" data-split>{t.faq.title}</h2>
          <p class="lead" data-reveal>{t.faq.intro}</p>
        </div>
        <div class="faq-list">
          {t.faq.items.map((f, i) => (
            <details name="faq" class="q" open={i === 0}>
              <summary><span class="q-text">{f.q}</span><span class="q-plus" aria-hidden="true"></span></summary>
              <div class="a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="close" id="escribeme" aria-labelledby="close-title">
      <a class="close-word" href={waGeneral} target="_blank" rel="noopener" data-wa="close" data-track="whatsapp_click" data-label="cierre" aria-label={t.close.wordLabel}>
        <span class="close-lead">{t.close.lead}</span>
        <svg class="close-arrow" aria-hidden="true" data-magnetic><use href="#i-arrow" /></svg>
        <span id="close-title" class="close-big" data-close-word>{t.close.word}</span>
      </a>
      <details class="close-form" data-close-form open>
        <summary class="close-summary"><span class="wrap close-summary-in"><span class="close-summary-title">{t.close.formTitle}</span><span class="q-plus" aria-hidden="true"></span></span></summary>
      <div class="wrap close-form-grid">
        <div class="close-intro">
          <p>{t.close.formIntro}</p>
          <div class="close-preview" aria-hidden="true">
            <p class="bubble-label">{t.close.previewLabel}</p>
            <p class="bubble bubble-out" data-form-preview>{baseMessage}</p>
          </div>
        </div>
        <form class="lead-form" data-lead-form novalidate>
          <div class="field"><label for="f-name">{t.close.name}</label><input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" /><p class="err" id="e-name" data-err="name"></p></div>
          <div class="field"><label for="f-business">{t.close.business}</label><input id="f-business" name="business" type="text" autocomplete="organization" required aria-describedby="e-business" /><p class="err" id="e-business" data-err="business"></p></div>
          <div class="field">
            <label for="f-sector">{t.close.sector}</label>
            <select id="f-sector" name="sector" required aria-describedby="e-sector">
              <option value="">{t.close.sectorPlaceholder}</option>
              {sectorIds.map((id) => <option value={id}>{t.sectors[id].chip}</option>)}
            </select>
            <p class="err" id="e-sector" data-err="sector"></p>
          </div>
          <div class="field"><label for="f-need">{t.close.need}</label><textarea id="f-need" name="need" rows="3" required placeholder={t.close.needPlaceholder} aria-describedby="e-need"></textarea><p class="err" id="e-need" data-err="need"></p></div>
          <div class="consent">
            <input id="f-consent" name="consent" type="checkbox" required aria-describedby="e-consent" />
            <label for="f-consent">{t.close.consentA}<a href={t.privacyHref}>{t.close.consentLink}</a>{t.close.consentB}</label>
            <p class="err" id="e-consent" data-err="consent"></p>
          </div>
          <button class="btn btn-submit" type="submit"><svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.close.submit}</button>
        </form>
      </div>
      </details>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-row">
      <div class="foot-cta">
        <p class="foot-invite">{t.footer.invite}</p>
        <a class="btn btn-accent foot-wa" href={waGeneral} target="_blank" rel="noopener" data-wa="footer" data-track="whatsapp_click" data-label="footer"><svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.footer.write}</a>
      </div>
      <div class="foot-side">
        <p class="foot-role">{t.footer.role}</p>
        <ul class="foot-links">
          <li><a href="#demos">{t.nav.demos}</a></li>
          <li><a href="#paquetes">{t.nav.packages}</a></li>
          <li><a href="#preguntas">{t.nav.faq}</a></li>
          <li><a href={t.privacyHref}>{t.footer.privacy}</a></li>
          <li><a href={t.otherHome} hreflang={isEs ? 'en' : 'es'} lang={isEs ? 'en' : 'es'}>{t.otherFull}</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap foot-legal"><p>© {new Date().getFullYear()} {BRAND_NAME}. {t.footer.fictional}</p><a href="#hero">{t.footer.top}</a></div>
    <div class="foot-mark-wrap" aria-hidden="true"><svg class="foot-mark" viewBox={`0 0 ${wordmark.w} 96`} data-foot-mark><path fill="currentColor" d={wordmark.d} /></svg></div>
  </footer>

  <a class="float" href={waGeneral} target="_blank" rel="noopener" aria-label={t.floatLabel} data-wa="float" data-track="whatsapp_click" data-label="flotante" data-float tabindex="-1">
    <svg aria-hidden="true"><use href="#i-wa" /></svg>
  </a>

  <dialog class="viewer" data-viewer aria-label={t.viewer.label} data-lenis-prevent>
    <div class="viewer-bar">
      <p class="viewer-name" data-viewer-name></p>
      <a class="btn btn-ghost viewer-tab" data-viewer-tab href="#" target="_blank" rel="noopener"><svg class="ico" aria-hidden="true"><use href="#i-arrow" /></svg><span class="only-wide">{t.viewer.newTab}</span><span class="only-narrow">{t.viewer.newTabShort}</span></a>
      <a class="btn btn-accent viewer-want" data-viewer-want href="#" target="_blank" rel="noopener" data-track="whatsapp_click"><svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>{t.viewer.want}</a>
      <button class="viewer-close" type="button" autofocus data-viewer-close aria-label={t.viewer.close}><svg aria-hidden="true"><use href="#i-close" /></svg></button>
    </div>
    <div class="viewer-body">
      <p class="viewer-loading" data-viewer-loading><span>{t.viewer.loading}</span> <a data-viewer-slow href="#" target="_blank" rel="noopener" hidden>{t.viewer.slow}</a></p>
      <iframe data-viewer-frame title={t.viewer.label} loading="eager" referrerpolicy="no-referrer"></iframe>
    </div>
  </dialog>

  <script type="application/json" id="page-data" set:html={JSON.stringify(pageData)} />
  <script src="../scripts/main.ts"></script>
</Base>
